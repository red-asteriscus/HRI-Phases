u:(e:FeedbackSurveyCompleted)
    ^start(animations/Stand/Gestures/Bow_1)
    "Your feedback has been submitted. Your opinion will help us improve future ceremonies." ~break500
    ^wait(animations/Stand/Gestures/Bow_1)
    $onStopped=1