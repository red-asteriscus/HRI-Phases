u:($surveyStep==recommend ~yes_answer)
    $feedbackSurveyAnswer="recommend_yes"
    "That makes me happy. I am glad you would welcome Pepper again."
    $feedbackSurveyAdvance="complete"
    $surveyStep=done
    "I am submitting your feedback now."

u:($surveyStep==recommend ~no_answer)
    $feedbackSurveyAnswer="recommend_no"
    "I understand. Your honesty helps us decide how Pepper can improve for future ceremonies."
    $feedbackSurveyAdvance="complete"
    $surveyStep=done
    "I am submitting your feedback now."

