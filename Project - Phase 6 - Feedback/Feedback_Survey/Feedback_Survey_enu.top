topic: ~feedback_survey()
language: enu

concept:(rating_one) [one "one star" "1" "1 star"]
concept:(rating_two) [two "two stars" "2" "2 stars"]
concept:(rating_three) [three "three stars" "3" "3 stars"]
concept:(rating_four) [four "four stars" "4" "4 stars"]
concept:(rating_five) [five "five stars" "5" "5 stars"]

concept:(yes_answer) [yes yeah yep sure "of course"]
concept:(no_answer) [no nope "not really"]

concept:(break50) \pau=50\
concept:(break100) \pau=100\
concept:(break500) \pau=500\

u:(e:onStart)
    $web=1
    $surveyStep=overall
    ^start(animations/Stand/Gestures/Explain_2)
    "Before we close, I would like to ask for your feedback about the graduation ceremony." ~break500
    "You can answer on the tablet, or by voice." ~break500
    "Please rate each question from one to five stars." ~break500
    "Question one. How would you rate the graduation ceremony overall?" ~break500
    ^wait(animations/Stand/Gestures/Explain_2)


u:($surveyStep==overall ~rating_one)
    $feedbackSurveyAnswer="overall_1"
    "I am sorry the ceremony did not feel good overall. Your honest rating helps us understand what needs to improve."
    $feedbackSurveyAdvance="organization"
    $surveyStep=organization
    "Question two. How would you rate the organization of the ceremony?"

u:($surveyStep==overall ~rating_two)
    $feedbackSurveyAnswer="overall_2"
    "I understand. It sounds like the ceremony could have been better. Your feedback will help us improve."
    $feedbackSurveyAdvance="organization"
    $surveyStep=organization
    "Question two. How would you rate the organization of the ceremony?"

u:($surveyStep==overall ~rating_three)
    $feedbackSurveyAnswer="overall_3"
    "I understand. A middle rating tells us there were good parts, but also room to improve."
    $feedbackSurveyAdvance="organization"
    $surveyStep=organization
    "Question two. How would you rate the organization of the ceremony?"

u:($surveyStep==overall ~rating_four)
    $feedbackSurveyAnswer="overall_4"
    "That is good to hear. I am glad the ceremony was mostly positive for you."
    $feedbackSurveyAdvance="organization"
    $surveyStep=organization
    "Question two. How would you rate the organization of the ceremony?"

u:($surveyStep==overall ~rating_five)
    $feedbackSurveyAnswer="overall_5"
    "Wonderful. I am very happy you enjoyed the ceremony."
    $feedbackSurveyAdvance="organization"
    $surveyStep=organization
    "Question two. How would you rate the organization of the ceremony?"

