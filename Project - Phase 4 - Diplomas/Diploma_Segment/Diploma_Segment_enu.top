# Dialogue Logic
u:(e:onStart)
    $web=1
    ^start(animations/Stand/Gestures/Explain_2)
    "Ladies and gentlemen, ~break50 we now arrive at the diploma           distribution segment." ~break500
    "This is the moment where we proudly recognize the achievements of our Computer Engineering graduates." ~break500
    "Each diploma represents years of effort, perseverance, learning, and dedication." ~break500
   
    ^start(animations/Stand/Gestures/Enthusiastic_5) 
    $onStopped=1

